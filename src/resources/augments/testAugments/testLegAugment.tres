[resource]
script = ExtResource("1_y86lt")
name = "ELEBOT"
description = "Electronic Leg Exoskeletal RoBOT. 
A pseudo-anthropromorphic mechanical structure composed of titanium alloy surgically mounted to the femur and tibia, with an electronic valve controlled hyrdraulic actuator mounted near the patella. 7 Degrees of freedom increases the users walking and running speed with mimimal risk of injury, as well as greatly dampening the impact of falls."
